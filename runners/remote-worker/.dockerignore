# Anything we DON'T want streamed into the build context. The COPY . .
# step in the Dockerfile pulls everything not listed here into the image,
# so excluding node_modules / dist alone is what stops the image from
# carrying a 700 MB local-install duplicate of what `npm ci` produces
# fresh in-image.
node_modules
dist
.git
.github
.idea
.vscode
*.log
*.tmp
*.bak
.DS_Store
.npm
.cache
.claude
.playwright-cli
coverage
.env
.env.*
local
# Playground local-mode entrypoint — never shipped in the production image
# (docs/design/playground.md §13 step 6). oneshot.ts never loads it; this keeps
# the bytes out too. NOTE the local-mode SKILL overlay is NOT excluded: it lives
# in the skill library (skills/aep/overlays/), which arrives via the `skills`
# named build context, and the assembler is what keeps it out of a session.
src/local.ts
# Dev CLI for hand-installing the plugin; no run path touches it.
src/assemble.ts
.plugin-dev
