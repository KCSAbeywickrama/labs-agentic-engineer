{
  "model": "anthropic/claude-haiku-4-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "default_agent": "aep",
  "subagent_depth": 3,
  "autoupdate": false,
  "share": "disabled",
  "plugin": [
    "/scratch/aepguard"
  ],
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    }
  },
  "agent": {
    "aep": {
      "mode": "primary",
      "description": "AEP coding run lead"
    },
    "general": {
      "mode": "subagent",
      "model": "anthropic/claude-haiku-4-5",
      "permission": {
        "todowrite": "deny",
        "task": "allow"
      }
    },
    "general-fast": {
      "mode": "subagent",
      "model": "anthropic/claude-haiku-4-5",
      "description": "Fast subagent for small work",
      "permission": {
        "todowrite": "deny",
        "task": "allow"
      }
    },
    "forbidden-agent": {
      "mode": "subagent",
      "description": "A subagent the platform does not allow"
    },
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "scout": {
      "disable": true
    }
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "bash": "allow",
    "task": {
      "*": "deny",
      "general": "allow",
      "general-fast": "allow"
    },
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": {
      "*": "deny",
      "allowed-skill": "allow"
    },
    "question": "deny",
    "external_directory": "deny",
    "doom_loop": "allow",
    "lsp": "deny"
  },
  "tools": {
    "lsp": false
  },
  "instructions": [
    "/scratch/spikes/instr.md"
  ]
}