{
  "model": "anthropic/claude-haiku-4-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "default_agent": "aep",
  "subagent_depth": 3,
  "autoupdate": false,
  "share": "disabled",
  "plugin": [
    "/scratch/ocbin/aep-guard.js"
  ],
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    }
  },
  "agent": {
    "aep": {
      "mode": "primary",
      "description": "AEP coding run lead"
    },
    "general": {
      "mode": "subagent",
      "model": "anthropic/claude-haiku-4-5",
      "permission": {
        "todowrite": "deny",
        "task": "allow"
      }
    },
    "general-fast": {
      "mode": "subagent",
      "model": "anthropic/claude-haiku-4-5",
      "description": "Fast subagent for small work",
      "permission": {
        "todowrite": "deny",
        "task": "allow"
      }
    },
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "scout": {
      "disable": true
    }
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "bash": "allow",
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "question": "deny",
    "external_directory": "deny",
    "doom_loop": "allow",
    "lsp": "deny"
  },
  "tools": {
    "lsp": false
  },
  "logLevel": "DEBUG"
}