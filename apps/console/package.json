{
  "name": "@aep/console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "gen": "openapi-typescript ../../packages/contracts/api/v1/openapi.yaml -o src/generated/aep-api.d.ts && tsr generate"
  },
  "dependencies": {
    "@aep/design-projection": "workspace:*",
    "@aep/excalidraw-dsl": "workspace:*",
    "@aep/ui-cell-diagram-view": "workspace:*",
    "@aep/ui-excalidraw-view": "workspace:*",
    "@aep/ui-openapi-view": "workspace:*",
    "@hocuspocus/provider": "4.3.0",
    "@tanstack/react-query": "5.90.5",
    "@tanstack/react-router": "1.170.17",
    "@tiptap/core": "^3.27.2",
    "@tiptap/extension-collaboration": "^3.27.2",
    "@tiptap/extension-collaboration-caret": "^3.27.2",
    "@tiptap/markdown": "^3.27.2",
    "@tiptap/pm": "^3.27.2",
    "@tiptap/react": "^3.27.2",
    "@tiptap/starter-kit": "^3.27.2",
    "@wso2/oxygen-ui": "0.11.0",
    "@wso2/oxygen-ui-icons-react": "0.11.0",
    "oidc-client-ts": "^3.5.0",
    "openapi-fetch": "0.14.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-oidc-context": "^3.3.1",
    "y-prosemirror": "^1.3.7",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "@tanstack/router-cli": "1.167.18",
    "@tanstack/router-plugin": "1.168.19",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react-swc": "4.2.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "msw": "^2.12.0",
    "openapi-typescript": "^7.4.2",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
