{
  "name": "@aep/agent-eval",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Evaluates a generated AI agent's behaviour during its build: the scenario schema (what to test an agent with) and the rubric that scores its responses.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "echo \"@aep/agent-eval: no dev server\""
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
