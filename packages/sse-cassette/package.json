{
  "name": "@aep/sse-cassette",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HTTP record/replay cassettes for streaming (SSE) endpoints: a recording reverse proxy that captures exact response bytes, chunk boundaries and inter-chunk delays, plus replay helpers that serve them back as a ReadableStream or a mock HTTP server in tests.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "record": "tsx src/cli.ts record",
    "serve": "tsx src/cli.ts serve",
    "dev": "echo \"@aep/sse-cassette: no dev server\""
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.21.0"
  }
}
