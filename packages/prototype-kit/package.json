{
  "name": "@wso2/prototype-kit",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "The kit a generated prototype is written against (defineApp, hooks, a mock data store, neutral components), plus the manifest schema, the source and render checks, the sandboxed frame host and the theme build helper.",
  "exports": {
    "./manifest": {
      "types": "./dist/manifest/index.d.ts",
      "default": "./dist/manifest/index.js"
    },
    "./manifest/schema.json": "./schema/prototype-manifest.schema.json",
    "./source": {
      "types": "./dist/source/index.d.ts",
      "default": "./dist/source/index.js"
    },
    "./check": {
      "types": "./dist/check/index.d.ts",
      "default": "./dist/check/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen": "tsx scripts/generate.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "echo \"@wso2/prototype-kit: no dev server\""
  },
  "dependencies": {
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.5",
    "sucrase": "^3.35.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
