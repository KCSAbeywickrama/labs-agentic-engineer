{
  "name": "@aep/design-projection",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure projections over the design bundle: frontmatter → DesignJson → cell-diagram model / per-component slices.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "dev": "echo \"@aep/design-projection: no dev server\""
  },
  "dependencies": {
    "@aep/contracts": "workspace:*",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
