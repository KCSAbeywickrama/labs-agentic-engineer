{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^specs\\/(design|validation\\/acceptance)\\/[^/].*$"
          },
          "checkedHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "comments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "author": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ],
                  "additionalProperties": false
                },
                "text": {
                  "type": "string",
                  "maxLength": 4000,
                  "pattern": "\\S"
                },
                "createdAt": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "draft",
                    "sent",
                    "addressed",
                    "reopened"
                  ]
                },
                "sentAt": {
                  "type": "string",
                  "minLength": 1
                },
                "reply": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "revision": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "addressedAt": {
                  "type": "string",
                  "minLength": 1
                },
                "anchor": {
                  "type": "object",
                  "properties": {
                    "screenId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "flowId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "roleId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "stateId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "elementIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    }
                  },
                  "required": [
                    "screenId",
                    "roleId",
                    "stateId",
                    "elementIds"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "author",
                "text",
                "createdAt",
                "status"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "artifacts"
  ],
  "additionalProperties": false
}
