{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "gen": {
      "inputs": ["openapi/**", "**/*.schema.json"],
      "outputs": ["src/generated/**", "generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "gen"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "gen"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build", "gen"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
