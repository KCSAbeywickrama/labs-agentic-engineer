{
  "name": "@aep/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive spec agents (Vercel AI SDK). Seeded with the main file-mutation agent.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "dev": "tsx watch src/agents/main/run.ts",
    "main": "tsx src/agents/main/run.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "ai": "^7.0.2",
    "yaml": "^2.8.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0"
  }
}
