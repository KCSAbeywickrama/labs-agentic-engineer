# Server
PORT=4000
LOG_LEVEL=info

# Agent model + loop budget (steps batch parallel tool calls, so the budget is
# higher than the per-turn file-call count).
AGENT_MODEL=claude-sonnet-5
AGENT_MAX_STEPS=20
# Anthropic reasoning effort per turn: low | medium | high | xhigh | max.
# The provider default is high; medium trades a little depth for faster
# time-to-first-artifact on the well-specified generation flows.
AGENT_REASONING_EFFORT=medium
# Per-step output-token ceiling. Unset, the Anthropic provider defaults to ~4096,
# which truncates a real spec/design mid-tool-call (no tool-call frame → empty
# fold). Sonnet-class models support 64k output tokens.
AGENT_MAX_OUTPUT_TOKENS=64000

# SSE keep-alive cadence (ms) while a turn streams, so long generations survive
# an idle-timeout ingress.
AGENT_KEEPALIVE_MS=15000

# M2M gate (always on): set a JWKS URL (RS256) OR a shared secret (HS256) — the
# service refuses to boot with neither. AGENT_JWT_SECRET must match the BFF's
# AGENTS_SVC_JWT_SECRET, and AGENT_JWT_AUDIENCE its AGENTS_SVC_JWT_AUDIENCE.
AGENT_JWT_AUDIENCE=agents-service
AGENT_JWT_ISSUER=aep-bff
# AGENT_JWT_JWKS_URL=https://idp.example/.well-known/jwks.json
AGENT_JWT_SECRET=dev-agents-m2m-secret

# Shared workspaces mount — read-only per-SHA snapshots written by aep-api
# (docs/design/shared-volume-clone-architecture.md). Compose/k8s mount it :ro;
# this service never writes it.
WORKSPACE_MOUNT_ROOT=/workspaces

# ConversationStore: Postgres when DATABASE_URL is set, else in-memory. Threads
# embed inlined snapshots, so a TTL sweep on updated_at reclaims stored rows.
DATABASE_URL=postgres://aep:aep@localhost:5432/aep?sslmode=disable
CONVERSATIONS_TTL_MS=604800000
CONVERSATIONS_SWEEP_MS=3600000

# Evals/playground only. The server builds the model per turn from the
# X-Anthropic-Key request header (no boot-time key); the eval/playground
# harnesses read this and send it as a header like any caller.
# ANTHROPIC_API_KEY=sk-ant-...
