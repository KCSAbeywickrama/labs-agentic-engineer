# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=info

# OpenChoreo Platform API (required)
PLATFORM_API_SERVICE_BASE_URL=http://api.openchoreo.localhost:8195
PLATFORM_API_SERVICE_HOST=

# Database (for future use)
DATABASE_URL=postgres://aep:aep@localhost:5432/aep?sslmode=disable

# Test mode — enables test-only endpoints
TEST_MODE=false

# Git host provider (clients/<provider> behind gitrepo's ports). Only "github"
# is supported today; boot fails on any other value.
GIT_PROVIDER=github

# BFF's own base URL as reached by peer cluster-internal services
# (agents-service) for the internal MCP discovery surface. When set, the BFF
# hands agents-service an `mcp: {url, token}` bundle so it can call back to
# <this>/internal/v1/mcp with a BFF-signed MCP token. Optional — empty omits
# the additive `mcp` field (consumed in the E-phase).
AEP_API_INTERNAL_BASE_URL=
