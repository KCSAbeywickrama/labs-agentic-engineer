{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "buildpack": {
      "type": "string",
      "minLength": 1
    },
    "appPath": {
      "type": "string",
      "minLength": 1
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "exposure": {
      "type": "string",
      "enum": [
        "internet",
        "intranet"
      ]
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "http",
              "datastore",
              "connector"
            ]
          },
          "onPlatform": {
            "type": "boolean"
          }
        },
        "required": [
          "to",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "name",
    "type",
    "version",
    "language",
    "buildpack",
    "appPath",
    "entrypoint",
    "exposure",
    "connections",
    "description"
  ],
  "additionalProperties": false
}
