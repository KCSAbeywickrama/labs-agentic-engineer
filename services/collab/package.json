{
  "name": "@aep/collab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Yjs collaboration server for spec files (Hocuspocus): rooms, BFF-oracle auth, lazy seeding. Issue #86 phase 1.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "@hocuspocus/server": "^4.3.0",
    "@tiptap/core": "^3.27.2",
    "@tiptap/markdown": "^3.27.2",
    "@tiptap/starter-kit": "^3.27.2",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.3.0",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.21.0",
    "ws": "^8.18.0"
  }
}
