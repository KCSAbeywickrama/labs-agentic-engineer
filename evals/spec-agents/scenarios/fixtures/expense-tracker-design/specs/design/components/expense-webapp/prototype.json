    { "id": "flow.approve-claim", "name": "Approve a claim", "roleId": "Approver",
      "screenIds": ["screen.queue", "screen.queue-detail"] },
    { "id": "flow.reject-claim", "name": "Reject a claim with a reason", "roleId": "Approver",
      "screenIds": ["screen.queue", "screen.queue-detail"] },
    { "id": "flow.monthly-report", "name": "Read the monthly total", "roleId": "Approver",
      "screenIds": ["screen.report"] }
