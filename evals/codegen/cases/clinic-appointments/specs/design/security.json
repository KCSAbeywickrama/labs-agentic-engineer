{
  "version": 3,
  "permissions": [
    {
      "resource": "slots",
      "component": "clinic-api",
      "description": "Doctor availability slots",
      "actions": [
        { "handle": "browse", "description": "Browse every doctor's open slots" },
        { "handle": "manage", "description": "Publish, list and remove the caller's own slots" }
      ]
    },
    {
      "resource": "appointments",
      "component": "clinic-api",
      "description": "Appointments and their lifecycle",
      "actions": [
        { "handle": "read", "description": "The caller's own appointments as a patient" },
        { "handle": "manage", "description": "Book, reschedule and cancel the caller's own appointments" },
        { "handle": "read-schedule", "description": "The caller's appointments as a doctor" },
        { "handle": "read-all", "description": "Every appointment" },
        { "handle": "manage-all", "description": "Book, reschedule and cancel any patient's appointment" },
        { "handle": "check-in", "description": "Check a patient in, or undo a check-in" }
      ]
    },
    {
      "resource": "patients",
      "component": "clinic-api",
      "description": "Patient records at the front desk",
      "actions": [
        { "handle": "manage", "description": "Search and register patients" }
      ]
    },
    {
      "resource": "visit-notes",
      "component": "clinic-api",
      "description": "Doctor-only visit notes",
      "actions": [
        { "handle": "read", "description": "Read notes on the caller's own appointments" },
        { "handle": "write", "description": "Write and edit notes on the caller's own appointments" },
        { "handle": "read-all", "description": "Read every earlier note of a patient" }
      ]
    }
  ],
  "groups": [
    { "name": "Doctors", "description": "Clinic doctors" },
    { "name": "Receptionists", "description": "Front-desk staff" }
  ],
  "roles": [
    {
      "name": "Patient",
      "description": "Browses slots and manages their own appointments.",
      "stories": ["F1.5", "F2.1", "F2.2", "F2.3", "F2.4", "F2.5"],
      "grants": ["slots:browse", "appointments:read", "appointments:manage"],
      "enrolment": "self-service"
    },
    {
      "name": "Doctor",
      "description": "Publishes availability, sees their day and writes visit notes.",
      "stories": ["F1.1", "F1.2", "F1.3", "F1.4", "F4.1", "F4.2", "F4.3", "F4.4", "F4.5", "F4.6"],
      "grants": ["slots:manage", "appointments:read-schedule", "visit-notes:read", "visit-notes:write", "visit-notes:read-all"],
      "assignTo": ["Doctors"]
    },
    {
      "name": "Receptionist",
      "description": "Books for patients and checks them in; never reads visit notes.",
      "stories": ["F1.6", "F3.1", "F3.2", "F3.3", "F3.4", "F3.5", "F3.6", "F3.7"],
      "grants": ["slots:browse", "appointments:read-all", "appointments:manage-all", "appointments:check-in", "patients:manage"],
      "assignTo": ["Receptionists"]
    }
  ],
  "testUsers": [
    { "username": "test-patient", "roles": ["Patient"] },
    { "username": "test-patient-2", "roles": ["Patient"] },
    { "username": "test-doctor", "roles": ["Doctor"] },
    { "username": "test-doctor-2", "roles": ["Doctor"] },
    { "username": "test-receptionist", "roles": ["Receptionist"] }
  ]
}
