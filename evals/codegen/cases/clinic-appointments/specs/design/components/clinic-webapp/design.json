  "description": "The single browser app for patients, doctors and receptionists, signing users in via SSO through Thunder and showing each role its own screens: slot browsing and booking, availability publishing, the front-desk day view with check-in, and the doctor's day with visit notes. It holds no business rules of its own and no secrets; it does not call anything except clinic-api.",
  "dependencies": [
    {
      "kind": "component",
      "name": "clinic-api",
      "description": "Loads slots, appointments, patients and visit notes and performs every booking, check-in and note action.",
      "wiring": {
        "endpoint": {
          "component": "ev-clinic-appointments-clinic-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "CLINIC_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "ev-clinic-appoint-4ed63457",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
