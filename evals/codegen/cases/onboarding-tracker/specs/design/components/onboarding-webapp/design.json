  "description": "Single-page app for HR coordinators (onboardings list, onboarding detail, task editing, overdue list) and department team members (their department's task list with overdue and due-soon flags, mark done, notes). Signs users in via SSO and shows only screens their role can load. It is the one user-facing surface; it holds no data itself and sends no notifications.",
  "dependencies": [
    {
      "kind": "component",
      "name": "onboarding-api",
      "wiring": {
        "endpoint": {
          "component": "ev-onboarding-tracker-onboarding-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "ONBOARDING_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "ev-onboarding-tra-032d8404",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
