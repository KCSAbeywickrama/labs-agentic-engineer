{
  "version": 3,
  "permissions": [
    {
      "resource": "onboardings",
      "component": "onboarding-api",
      "description": "New-hire onboardings",
      "actions": [
        { "handle": "read", "description": "Every onboarding with progress" },
        { "handle": "manage", "description": "Start, edit and close any onboarding" }
      ]
    },
    {
      "resource": "tasks",
      "component": "onboarding-api",
      "description": "Onboarding tasks",
      "actions": [
        { "handle": "read-all", "description": "Every task across departments" },
        { "handle": "manage", "description": "Add, edit and remove any task" },
        { "handle": "complete-all", "description": "Mark any task done" },
        { "handle": "read-it", "description": "IT tasks" },
        { "handle": "update-it", "description": "Complete or reopen IT tasks" },
        { "handle": "note-it", "description": "Add notes to IT tasks" },
        { "handle": "read-hr", "description": "HR tasks" },
        { "handle": "update-hr", "description": "Complete or reopen HR tasks" },
        { "handle": "note-hr", "description": "Add notes to HR tasks" },
        { "handle": "read-facilities", "description": "Facilities tasks" },
        { "handle": "update-facilities", "description": "Complete or reopen Facilities tasks" },
        { "handle": "note-facilities", "description": "Add notes to Facilities tasks" }
      ]
    }
  ],
  "groups": [
    { "name": "HR Coordinators", "description": "People who start and oversee onboardings" },
    { "name": "IT Onboarding Team", "description": "IT team members handling onboarding tasks" },
    { "name": "HR Onboarding Team", "description": "HR team members handling onboarding tasks" },
    { "name": "Facilities Onboarding Team", "description": "Facilities team members handling onboarding tasks" }
  ],
  "roles": [
    {
      "name": "HRCoordinator",
      "description": "HR coordinator: starts onboardings, manages tasks, sees everything and what is overdue.",
      "stories": ["F1.1", "F1.2", "F1.3", "F1.4", "F1.5", "F1.6", "F1.7", "F2.7", "F2.8", "F3.3", "F3.4"],
      "grants": ["onboardings:read", "onboardings:manage", "tasks:read-all", "tasks:manage", "tasks:complete-all"],
      "assignTo": ["HR Coordinators"]
    },
    {
      "name": "ITTeamMember",
      "description": "IT team member: works the IT department's tasks.",
      "stories": ["F2.1", "F2.4", "F2.5", "F2.6", "F3.1", "F3.2", "F3.5", "F3.6"],
      "grants": ["tasks:read-it", "tasks:update-it", "tasks:note-it"],
      "assignTo": ["IT Onboarding Team"]
    },
    {
      "name": "HRTeamMember",
      "description": "HR team member: works the HR department's tasks.",
      "stories": ["F2.2", "F2.4", "F2.5", "F2.6", "F3.1", "F3.2", "F3.5", "F3.6"],
      "grants": ["tasks:read-hr", "tasks:update-hr", "tasks:note-hr"],
      "assignTo": ["HR Onboarding Team"]
    },
    {
      "name": "FacilitiesTeamMember",
      "description": "Facilities team member: works the Facilities department's tasks.",
      "stories": ["F2.3", "F2.4", "F2.5", "F2.6", "F3.1", "F3.2", "F3.5", "F3.6"],
      "grants": ["tasks:read-facilities", "tasks:update-facilities", "tasks:note-facilities"],
      "assignTo": ["Facilities Onboarding Team"]
    }
  ],
  "testUsers": [
    { "username": "test-hr-coordinator", "roles": ["HRCoordinator"] },
    { "username": "test-it-team-member", "roles": ["ITTeamMember"] },
    { "username": "test-it-team-member-2", "roles": ["ITTeamMember"] },
    { "username": "test-hr-team-member", "roles": ["HRTeamMember"] },
    { "username": "test-facilities-team-member", "roles": ["FacilitiesTeamMember"] }
  ]
}
