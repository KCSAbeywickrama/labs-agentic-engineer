  "description": "The single-page app for all four actors: organizers manage events, rooms, sessions, proposals, reviewers and registrations; speakers submit and follow proposals; reviewers score; attendees browse and register. Screens are gated by the operation each loads. It calls only the events API and signs in through Thunder SSO. It holds no secrets and no business logic beyond presentation.",
  "dependencies": [
    {
      "kind": "component",
      "name": "events-api",
      "description": "The only backend the web app calls; registration is reached through it (P3).",
      "wiring": {
        "endpoint": {
          "component": "ev-conference-planner-events-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "EVENTS_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "ev-conference-pla-d836ecc3",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
