    { "id": "screen.account", "name": "Account", "roleIds": ["Organizer", "Speaker", "Reviewer", "Attendee"] },
    { "id": "screen.settings", "name": "Settings", "roleIds": ["Organizer", "Speaker", "Reviewer", "Attendee"] },
