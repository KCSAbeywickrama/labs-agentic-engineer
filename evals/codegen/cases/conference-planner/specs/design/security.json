{
  "version": 3,
  "permissions": [
    {
      "resource": "events",
      "component": "events-api",
      "description": "Events, rooms, sessions and calls for proposals",
      "actions": [
        { "handle": "read", "description": "Every event, room and session" },
        { "handle": "manage", "description": "Create, change and delete events, rooms and sessions; open or close a call for proposals; assign speakers" }
      ]
    },
    {
      "resource": "proposals",
      "component": "events-api",
      "description": "Talk proposals",
      "actions": [
        { "handle": "submit", "description": "Submit a proposal to an event" },
        { "handle": "read", "description": "The caller's own proposals" },
        { "handle": "update", "description": "Edit or withdraw the caller's own proposal" },
        { "handle": "read-all", "description": "Every proposal of an event" },
        { "handle": "decide", "description": "Accept, reject or reopen any proposal" }
      ]
    },
    {
      "resource": "reviews",
      "component": "events-api",
      "description": "Proposal reviews and reviewer assignments",
      "actions": [
        { "handle": "read-assigned", "description": "Proposals of events the caller is assigned to review" },
        { "handle": "score", "description": "The caller's own score on a proposal" },
        { "handle": "read-all", "description": "Every review of any proposal" },
        { "handle": "assign", "description": "Assign reviewers to any event" }
      ]
    },
    {
      "resource": "registrations",
      "component": "events-api",
      "description": "Event and session registrations",
      "actions": [
        { "handle": "register", "description": "Register the caller" },
        { "handle": "read", "description": "The caller's own registrations" },
        { "handle": "cancel", "description": "Cancel the caller's own registration" },
        { "handle": "read-all", "description": "Every registration and waitlist of an event" },
        { "handle": "remove", "description": "Remove any attendee's registration" }
      ]
    }
  ],
  "groups": [
    { "name": "Organizers", "description": "People who run conferences" },
    { "name": "Speakers", "description": "People who submit talk proposals" },
    { "name": "Reviewers", "description": "People who score talk proposals" },
    { "name": "Attendees", "description": "People who register for conferences" }
  ],
  "roles": [
    {
      "name": "Organizer",
      "description": "Runs events, decides on proposals and manages registrations.",
      "stories": ["F1.1", "F1.2", "F1.3", "F1.4", "F1.5", "F1.6", "F1.7", "F2.5", "F2.6", "F3.4", "F3.5", "F3.6", "F3.7", "F4.7", "F4.8", "F4.9"],
      "grants": ["events:read", "events:manage", "proposals:read-all", "proposals:decide", "reviews:read-all", "reviews:assign", "registrations:read-all", "registrations:remove"],
      "assignTo": ["Organizers"]
    },
    {
      "name": "Speaker",
      "description": "Submits and follows their own talk proposals.",
      "stories": ["F1.9", "F2.1", "F2.2", "F2.3", "F2.4"],
      "grants": ["events:read", "proposals:submit", "proposals:read", "proposals:update"],
      "assignTo": ["Speakers"]
    },
    {
      "name": "Reviewer",
      "description": "Scores proposals of the events they are assigned to.",
      "stories": ["F3.1", "F3.2", "F3.3"],
      "grants": ["events:read", "reviews:read-assigned", "reviews:score"],
      "assignTo": ["Reviewers"]
    },
    {
      "name": "Attendee",
      "description": "Browses events and registers for events and sessions.",
      "stories": ["F1.8", "F4.1", "F4.2", "F4.3", "F4.4", "F4.5", "F4.6"],
      "grants": ["events:read", "registrations:register", "registrations:read", "registrations:cancel"],
      "assignTo": ["Attendees"]
    }
  ],
  "testUsers": [
    { "username": "test-organizer", "roles": ["Organizer"] },
    { "username": "test-speaker", "roles": ["Speaker"] },
    { "username": "test-speaker-2", "roles": ["Speaker"] },
    { "username": "test-reviewer", "roles": ["Reviewer"] },
    { "username": "test-reviewer-2", "roles": ["Reviewer"] },
    { "username": "test-attendee", "roles": ["Attendee"] },
    { "username": "test-attendee-2", "roles": ["Attendee"] }
  ]
}
