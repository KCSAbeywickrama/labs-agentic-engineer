{
  "version": 3,
  "permissions": [
    {
      "resource": "items",
      "component": "procurement-api",
      "description": "Catalogue items with their current stock",
      "actions": [
        { "handle": "read", "description": "Browse active catalogue items and their stock levels" },
        { "handle": "manage", "description": "Create, edit, price and deactivate any item" }
      ]
    },
    {
      "resource": "requests",
      "component": "procurement-api",
      "description": "Purchase requests",
      "actions": [
        { "handle": "read", "description": "The caller's own requests" },
        { "handle": "write", "description": "Create, edit, submit and withdraw the caller's own requests" },
        { "handle": "read-all", "description": "Every pending request within the caller's approval limit" },
        { "handle": "decide", "description": "Approve or reject a request within the caller's limit" }
      ]
    },
    {
      "resource": "decisions",
      "component": "procurement-api",
      "description": "Approval decisions",
      "actions": [
        { "handle": "read", "description": "The caller's own decisions" }
      ]
    },
    {
      "resource": "orders",
      "component": "procurement-api",
      "description": "Approved requests awaiting goods",
      "actions": [
        { "handle": "read", "description": "Every approved request with outstanding goods" }
      ]
    },
    {
      "resource": "receipts",
      "component": "procurement-api",
      "description": "Goods receipts",
      "actions": [
        { "handle": "create", "description": "Record a receipt against an approved request" },
        { "handle": "read", "description": "Every receipt of a request" }
      ]
    },
    {
      "resource": "ledger",
      "component": "procurement-api",
      "description": "Stock ledger",
      "actions": [
        { "handle": "read", "description": "Every ledger entry" }
      ]
    },
    {
      "resource": "low-stock",
      "component": "procurement-api",
      "description": "Items below reorder level",
      "actions": [
        { "handle": "read", "description": "The low-stock list" }
      ]
    }
  ],
  "groups": [
    { "name": "Requesters", "description": "Staff who raise purchase requests" },
    { "name": "Approvers", "description": "Staff with a purchase approval limit" },
    { "name": "WarehouseClerks", "description": "Warehouse staff who receive goods and keep the catalogue" }
  ],
  "roles": [
    {
      "name": "Requester",
      "description": "Raises purchase requests and follows their own requests.",
      "stories": ["F1.4", "F1.5", "F2.1", "F2.2", "F2.3", "F2.4", "F2.5", "F2.6", "F2.7", "F5.5", "F6.4", "F6.5"],
      "grants": ["items:read", "requests:read", "requests:write", "low-stock:read"],
      "assignTo": ["Requesters"]
    },
    {
      "name": "Approver",
      "description": "Approves or rejects pending requests within their approval limit.",
      "stories": ["F3.1", "F3.2", "F3.3", "F3.4", "F3.5"],
      "grants": ["requests:read-all", "requests:decide", "decisions:read"],
      "assignTo": ["Approvers"]
    },
    {
      "name": "WarehouseClerk",
      "description": "Maintains the catalogue, receives goods and reads stock, ledger and low-stock.",
      "stories": ["F1.1", "F1.2", "F1.3", "F1.6", "F4.1", "F4.2", "F4.3", "F4.4", "F4.5", "F4.6", "F5.1", "F5.2", "F5.3", "F5.4", "F6.1", "F6.2", "F6.3"],
      "grants": ["items:read", "items:manage", "orders:read", "receipts:create", "receipts:read", "ledger:read", "low-stock:read"],
      "assignTo": ["WarehouseClerks"]
    }
  ],
  "testUsers": [
    { "username": "test-requester", "roles": ["Requester"] },
    { "username": "test-requester-2", "roles": ["Requester"] },
    { "username": "test-approver", "roles": ["Approver"] },
    { "username": "test-warehouse-clerk", "roles": ["WarehouseClerk"] }
  ]
}
