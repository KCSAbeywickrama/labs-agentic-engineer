  "description": "Single-page app for requesters, approvers and warehouse clerks: catalogue, purchase requests, approvals queue, goods receiving, stock and ledger, and the low-stock view. Signs users in through Thunder SSO and gates screens by the operation each loads. Calls only the procurement API; never the inventory service. Holds no secrets.",
  "dependencies": [
    {
      "kind": "component",
      "name": "procurement-api",
      "description": "The only backend the web app calls (P2).",
      "wiring": {
        "endpoint": {
          "component": "ev-procurement-inventory-procurement-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "PROCUREMENT_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "ev-procurement-in-e2084e69",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
