  "description": "Single-page app for members (search, holds, own loans and fees) and librarians (titles and copies, checkout and check-in, holds queue, fees). One bundle serving both actors; screens are gated by the scope of the operation each loads. Calls only circulation-api and never the catalogue service.",
  "dependencies": [
    {
      "kind": "component",
      "name": "circulation-api",
      "description": "The only backend the app calls.",
      "wiring": {
        "endpoint": {
          "component": "ev-library-circulation-circulation-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "CIRCULATION_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "ev-library-circul-1d401a43",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
