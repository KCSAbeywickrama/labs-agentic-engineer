  "description": "The single backend the web app calls. Owns loans, holds and fees and enforces their rules (loan period, limits, queue order, late fee, unpaid-fee block), and fronts the catalogue by proxying title and copy operations to catalogue-service. Overdue status is derived on read; no background jobs. Keeps its own data (the platform catalogue offers no database resource). Does not store titles or copies.",
  "dependencies": [
    {
      "kind": "component",
      "name": "catalogue-service",
      "description": "Reads titles and copies and updates copy status; the only caller of the catalogue.",
      "wiring": {
        "endpoint": {
          "component": "ev-library-circulation-catalogue-service",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "CATALOGUE_SERVICE_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "ev-library-circul-1d401a43",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "thunder-authentication",
    "api-management"
  ]
}
