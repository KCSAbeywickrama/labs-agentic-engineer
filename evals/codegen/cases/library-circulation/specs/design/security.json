{
  "version": 3,
  "permissions": [
    {
      "resource": "catalogue",
      "component": "circulation-api",
      "description": "Titles and copies",
      "actions": [
        { "handle": "manage", "description": "Add, edit and remove titles; add, edit and withdraw copies" }
      ]
    },
    {
      "resource": "loans",
      "component": "circulation-api",
      "description": "Loans",
      "actions": [
        { "handle": "read", "description": "The caller's own loans" },
        { "handle": "read-all", "description": "Every loan" },
        { "handle": "manage", "description": "Check out, check in and renew any loan" }
      ]
    },
    {
      "resource": "holds",
      "component": "circulation-api",
      "description": "Holds",
      "actions": [
        { "handle": "read", "description": "The caller's own holds" },
        { "handle": "place", "description": "Place and cancel the caller's own holds" },
        { "handle": "read-all", "description": "Every hold" },
        { "handle": "manage", "description": "Mark ready, fulfil and cancel any hold" }
      ]
    },
    {
      "resource": "fees",
      "component": "circulation-api",
      "description": "Late fees",
      "actions": [
        { "handle": "read", "description": "The caller's own fees and balance" },
        { "handle": "read-all", "description": "Every member's fees" },
        { "handle": "manage", "description": "Record a payment or waive any fee" }
      ]
    }
  ],
  "groups": [
    { "name": "Members", "description": "Library members who borrow items" },
    { "name": "Librarians", "description": "Library staff who run circulation" }
  ],
  "roles": [
    {
      "name": "Member",
      "description": "Searches the catalogue, places holds and follows their own loans and fees.",
      "stories": ["F1.1", "F1.2", "F2.4", "F2.5", "F3.1", "F3.2", "F3.3", "F4.2", "F4.3"],
      "grants": ["loans:read", "holds:read", "holds:place", "fees:read"],
      "assignTo": ["Members"]
    },
    {
      "name": "Librarian",
      "description": "Manages titles and copies, checks items out and in, works the holds queue and fees.",
      "stories": ["F1.3", "F1.4", "F1.5", "F2.1", "F2.2", "F2.3", "F2.6", "F3.4", "F3.5", "F3.6", "F3.7", "F4.1", "F4.4", "F4.5", "F4.6"],
      "grants": ["catalogue:manage", "loans:read-all", "loans:manage", "holds:read-all", "holds:manage", "fees:read-all", "fees:manage"],
      "assignTo": ["Librarians"]
    }
  ],
  "testUsers": [
    { "username": "test-member", "roles": ["Member"] },
    { "username": "test-member-2", "roles": ["Member"] },
    { "username": "test-librarian", "roles": ["Librarian"] }
  ]
}
