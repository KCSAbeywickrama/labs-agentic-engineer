  "description": "The one browser surface for employees, support agents and team leads: raising and following tickets, handling them (a team lead picks a known agent or types a username to assign), commenting, and the filtered queue with SLA breach. Screens shown depend on the signed-in role. It holds no data or secrets of its own and does not talk to anything but the help desk API and Thunder.",
  "dependencies": [
    {
      "kind": "component",
      "name": "helpdesk-api",
      "description": "Every screen loads and changes tickets and comments through this API.",
      "wiring": {
        "endpoint": {
          "component": "ev-helpdesk-tickets-helpdesk-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "HELPDESK_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "description": "SSO sign-in through Thunder.",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "ev-helpdesk-ticke-54feb9ea",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
