{
  "version": 3,
  "permissions": [
    {
      "resource": "tickets",
      "component": "helpdesk-api",
      "description": "Support tickets and their handling",
      "actions": [
        { "handle": "create", "description": "Raise a ticket as the caller" },
        { "handle": "read", "description": "The caller's own tickets" },
        { "handle": "update", "description": "Edit the caller's own ticket before triage" },
        { "handle": "reopen", "description": "Reopen the caller's own resolved ticket" },
        { "handle": "read-all", "description": "Every ticket, with queue filters" },
        { "handle": "triage", "description": "Triage any open ticket" },
        { "handle": "claim", "description": "Assign any ticket to the caller" },
        { "handle": "assign", "description": "Assign any ticket to a support agent by id or username" },
        { "handle": "start", "description": "Start work on any ticket" },
        { "handle": "resolve", "description": "Resolve any ticket" }
      ]
    },
    {
      "resource": "comments",
      "component": "helpdesk-api",
      "description": "Ticket comment threads",
      "actions": [
        { "handle": "create", "description": "Comment on the caller's own tickets" },
        { "handle": "read", "description": "Read the thread of the caller's own tickets" },
        { "handle": "create-all", "description": "Comment on any ticket" },
        { "handle": "read-all", "description": "Read the thread of any ticket" }
      ]
    },
    {
      "resource": "agents",
      "component": "helpdesk-api",
      "description": "Support agents available for assignment and filtering",
      "actions": [
        { "handle": "read", "description": "List support agents" }
      ]
    }
  ],
  "groups": [
    { "name": "Employees", "description": "Everyone who can raise IT tickets" },
    { "name": "Support Agents", "description": "IT staff who work tickets" },
    { "name": "Team Leads", "description": "Leads of the support team" }
  ],
  "roles": [
    {
      "name": "Employee",
      "description": "Raises, follows, edits and reopens their own tickets and comments on them.",
      "stories": ["F1.1", "F1.2", "F1.3", "F1.4", "F1.5", "F2.6", "F3.1", "F3.4"],
      "grants": ["tickets:create", "tickets:read", "tickets:update", "tickets:reopen", "comments:create", "comments:read"],
      "assignTo": ["Employees"]
    },
    {
      "name": "Support Agent",
      "description": "Sees the whole queue, triages, takes, works and resolves tickets, and comments on any ticket.",
      "stories": ["F2.1", "F2.2", "F2.4", "F2.5", "F2.7", "F3.2", "F3.5", "F4.1", "F4.3", "F4.4", "F4.5", "F4.8"],
      "grants": ["tickets:read-all", "tickets:triage", "tickets:claim", "tickets:start", "tickets:resolve", "comments:create-all", "comments:read-all", "agents:read"],
      "assignTo": ["Support Agents"]
    },
    {
      "name": "Team Lead",
      "description": "Watches the whole queue and SLA breaches, assigns tickets to agents, and comments on any ticket.",
      "stories": ["F2.3", "F3.3", "F4.2", "F4.6", "F4.7"],
      "grants": ["tickets:read-all", "tickets:assign", "comments:create-all", "comments:read-all", "agents:read"],
      "assignTo": ["Team Leads"]
    }
  ],
  "testUsers": [
    { "username": "test-employee", "roles": ["Employee"] },
    { "username": "test-employee-2", "roles": ["Employee"] },
    { "username": "test-support-agent", "roles": ["Support Agent"] },
    { "username": "test-team-lead", "roles": ["Team Lead"] }
  ]
}
