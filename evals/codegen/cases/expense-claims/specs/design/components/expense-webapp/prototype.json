    { "id": "screen.export-history", "name": "Export history", "roleIds": ["FinanceReviewer"] },
    { "id": "screen.account", "name": "Account", "roleIds": ["Employee", "Manager", "FinanceReviewer"] },
    { "id": "screen.settings", "name": "Settings", "roleIds": ["Employee", "Manager", "FinanceReviewer"] },
    { "id": "screen.signed-out", "name": "Signed out", "roleIds": ["Employee", "Manager", "FinanceReviewer"] }
