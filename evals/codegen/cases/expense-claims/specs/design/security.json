{
  "version": 3,
  "permissions": [
    {
      "resource": "claims",
      "component": "expense-api",
      "description": "Expense claims and their approval",
      "actions": [
        { "handle": "read", "description": "The caller's own claims" },
        { "handle": "submit", "description": "Create, edit, submit and withdraw the caller's own claims" },
        { "handle": "review-team", "description": "Claims of the caller's direct reports" },
        { "handle": "approve", "description": "Approve a submitted claim of a direct report" },
        { "handle": "reject", "description": "Reject a submitted claim of a direct report" },
        { "handle": "read-all", "description": "Every claim" }
      ]
    },
    {
      "resource": "exports",
      "component": "expense-api",
      "description": "Payroll export batches",
      "actions": [
        { "handle": "create", "description": "Export approved claims as a batch" },
        { "handle": "read", "description": "Every export batch and its CSV" }
      ]
    },
    {
      "resource": "employees",
      "component": "expense-api",
      "description": "Employee reporting lines",
      "actions": [
        { "handle": "manage", "description": "List employees and set their manager" }
      ]
    }
  ],
  "groups": [
    { "name": "Employees", "description": "Everyone who files expense claims" },
    { "name": "Managers", "description": "People who approve their team's claims" },
    { "name": "Finance", "description": "Finance staff who export claims to payroll" }
  ],
  "roles": [
    {
      "name": "Employee",
      "description": "Submits and follows their own claims.",
      "stories": ["F1.1", "F1.2", "F1.3", "F1.4", "F1.5", "F1.6", "F1.7"],
      "grants": ["claims:read", "claims:submit"],
      "assignTo": ["Employees"]
    },
    {
      "name": "Manager",
      "description": "Reviews, approves or rejects claims of direct reports; also files their own.",
      "stories": ["F2.1", "F2.2", "F2.3", "F2.4", "F2.5"],
      "grants": ["claims:read", "claims:submit", "claims:review-team", "claims:approve", "claims:reject"],
      "assignTo": ["Managers"]
    },
    {
      "name": "PayrollExporter",
      "description": "The Finance actor: exports approved claims to payroll and maintains reporting lines.",
      "stories": ["F2.1", "F2.6", "F3.1", "F3.2", "F3.3", "F3.4", "F3.5"],
      "grants": ["claims:read-all", "exports:create", "exports:read", "employees:manage"],
      "assignTo": ["Finance"]
    }
  ],
  "testUsers": [
    { "username": "test-employee", "roles": ["Employee"] },
    { "username": "test-employee-2", "roles": ["Employee"] },
    { "username": "test-manager", "roles": ["Manager"] },
    { "username": "test-manager-2", "roles": ["Manager"] },
    { "username": "test-payroll-exporter", "roles": ["PayrollExporter"] }
  ]
}
